<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vas_trial_balance" model="ir.actions.report">
        <field name="name">Bảng cân đối số phát sinh</field>
        <field name="model">vas.trial.balance.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">connecta_vas.report_vas_trial_balance</field>
        <field name="report_file">connecta_vas.report_vas_trial_balance</field>
        <field name="print_report_name">'BCDPS_F01_%s_%s' % (object.period_from_id.name or '', object.period_to_id.name or '')</field>
    </record>

    <template id="report_vas_trial_balance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wiz">
                <div class="page" style="font-size: 10px;">
                    <div class="row mb-2">
                        <div class="col-7"><strong t-esc="wiz.company_id.name"/></div>
                        <div class="col-5 text-end">
                            Mẫu số: <strong t-esc="wiz.form_code"/>
                        </div>
                    </div>
                    <h4 class="text-center text-uppercase">Bảng cân đối số phát sinh</h4>
                    <p class="text-center mb-2">
                        Kỳ báo cáo: từ
                        <span t-esc="wiz.period_from_id.name"/>
                        đến
                        <span t-esc="wiz.period_to_id.name"/>
                    </p>
                    <t t-if="wiz.warning_text">
                        <div class="alert alert-warning" style="white-space: pre-wrap;"
                             t-esc="wiz.warning_text"/>
                    </t>
                    <table class="table table-sm table-bordered o_main_table">
                        <thead>
                            <tr>
                                <th rowspan="2">Số hiệu TK</th>
                                <th rowspan="2">Tên tài khoản</th>
                                <th colspan="2" class="text-center">Số dư đầu kỳ</th>
                                <th colspan="2" class="text-center">Phát sinh</th>
                                <th colspan="2" class="text-center">Số dư cuối kỳ</th>
                            </tr>
                            <tr>
                                <th class="text-end">Nợ</th>
                                <th class="text-end">Có</th>
                                <th class="text-end">Nợ</th>
                                <th class="text-end">Có</th>
                                <th class="text-end">Nợ</th>
                                <th class="text-end">Có</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="wiz.get_report_lines()" t-as="line"
                                t-att-style="'font-weight:bold' if line.row_type == 'total' else ''">
                                <td><span t-esc="line.account_code or ''"/></td>
                                <td><span t-esc="line.account_name or ''"/></td>
                                <td class="text-end">
                                    <span t-esc="'{:,.0f}'.format(line.opening_debit)"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.0f}'.format(line.opening_credit)"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.0f}'.format(line.ps_debit)"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.0f}'.format(line.ps_credit)"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.0f}'.format(line.closing_debit)"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.0f}'.format(line.closing_credit)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
