    <record id="ind_04_23" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">23</field>
        <field name="name">Thuế phân phối HH (DT × tỷ lệ dữ liệu)</field>
        <field name="sequence">240</field>
        <field name="column_kind">tax</field>
        <field name="source_kind">direct_industry_tax</field>
        <field name="ledger_tag">DIST</field>
    </record>
    <record id="ind_04_24" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">24</field>
        <field name="name">DT dịch vụ, XD không bao thầu NVL</field>
        <field name="sequence">250</field>
        <field name="column_kind">value</field>
        <field name="source_kind">ledger_direct_revenue</field>
        <field name="ledger_tag">SVC</field>
    </record>
    <record id="ind_04_25" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">25</field>
        <field name="name">Thuế DV/XD không bao thầu</field>
        <field name="sequence">260</field>
        <field name="column_kind">tax</field>
        <field name="source_kind">direct_industry_tax</field>
        <field name="ledger_tag">SVC</field>
    </record>
    <record id="ind_04_26" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">26</field>
        <field name="name">DT SX/vận tải/DV gắn HH, XD bao thầu</field>
        <field name="sequence">270</field>
        <field name="column_kind">value</field>
        <field name="source_kind">ledger_direct_revenue</field>
        <field name="ledger_tag">MFG</field>
    </record>
    <record id="ind_04_27" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">27</field>
        <field name="name">Thuế SX/vận tải/XD bao thầu</field>
        <field name="sequence">280</field>
        <field name="column_kind">tax</field>
        <field name="source_kind">direct_industry_tax</field>
        <field name="ledger_tag">MFG</field>
