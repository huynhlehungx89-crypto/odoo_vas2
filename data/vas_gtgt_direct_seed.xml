<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Phương pháp trên loại tờ -->
    <record id="vas_gtgt_form_01" model="vas.gtgt.form.type">
        <field name="tax_method">deduction</field>
    </record>
    <record id="vas_gtgt_form_03" model="vas.gtgt.form.type">
        <field name="code">03/GTGT</field>
        <field name="name">Tờ khai GTGT (trực tiếp trên GTGT — vàng bạc đá quý)</field>
        <field name="tax_method">direct</field>
    </record>
    <record id="vas_gtgt_form_04" model="vas.gtgt.form.type">
        <field name="code">04/GTGT</field>
        <field name="name">Tờ khai GTGT (trực tiếp trên doanh thu)</field>
        <field name="tax_method">direct</field>
    </record>

    <!-- Bốn nhóm ngành mẫu 04 + nhóm vàng mẫu 03 -->
    <record id="vas_gtgt_ind_dist" model="vas.gtgt.direct.industry">
        <field name="code">DIST</field>
        <field name="name">Phân phối, cung cấp hàng hóa</field>
        <field name="rate_percent">1</field>
        <field name="sequence">10</field>
        <field name="date_start">2026-07-01</field>
        <field name="declaration_revenue_tag">22</field>
    </record>
    <record id="vas_gtgt_ind_svc" model="vas.gtgt.direct.industry">
        <field name="code">SVC</field>
        <field name="name">Dịch vụ, xây dựng không bao thầu NVL</field>
        <field name="rate_percent">5</field>
        <field name="sequence">20</field>
        <field name="date_start">2026-07-01</field>
        <field name="declaration_revenue_tag">24</field>
    </record>
    <record id="vas_gtgt_ind_mfg" model="vas.gtgt.direct.industry">
        <field name="code">MFG</field>
        <field name="name">Sản xuất, vận tải, dịch vụ gắn HH, XD bao thầu NVL</field>
        <field name="rate_percent">3</field>
        <field name="sequence">30</field>
        <field name="date_start">2026-07-01</field>
        <field name="declaration_revenue_tag">26</field>
    </record>
    <record id="vas_gtgt_ind_other" model="vas.gtgt.direct.industry">
        <field name="code">OTHER</field>
        <field name="name">Hoạt động kinh doanh khác</field>
        <field name="rate_percent">2</field>
        <field name="sequence">40</field>
        <field name="date_start">2026-07-01</field>
        <field name="declaration_revenue_tag">28</field>
    </record>
    <record id="vas_gtgt_ind_gold" model="vas.gtgt.direct.industry">
        <field name="code">GOLD</field>
        <field name="name">Mua bán, chế tác vàng bạc, đá quý</field>
        <field name="rate_percent">10</field>
        <field name="sequence">5</field>
        <field name="date_start">2026-07-01</field>
        <field name="is_gold">1</field>
    </record>

    <!-- Phiên bản mẫu 04 TT89 -->
    <record id="vas_gtgt_version_04_tt89" model="vas.gtgt.form.version">
        <field name="code">TT89</field>
        <field name="name">Mẫu 04/GTGT theo Thông tư 89/2026/TT-BTC</field>
        <field name="form_type_id" ref="vas_gtgt_form_04"/>
        <field name="circular_label">Thông tư 89/2026/TT-BTC</field>
        <field name="date_start">2026-07-01</field>
    </record>
    <!-- Phiên bản mẫu 03 TT89 -->
    <record id="vas_gtgt_version_03_tt89" model="vas.gtgt.form.version">
        <field name="code">TT89</field>
        <field name="name">Mẫu 03/GTGT theo Thông tư 89/2026/TT-BTC</field>
        <field name="form_type_id" ref="vas_gtgt_form_03"/>
        <field name="circular_label">Thông tư 89/2026/TT-BTC</field>
        <field name="date_start">2026-07-01</field>
    </record>

    <!-- Chỉ tiêu 04 -->
    <record id="ind_04_21a" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">21a</field>
        <field name="name">Tổng doanh thu không chịu thuế</field>
        <field name="sequence">210</field>
        <field name="column_kind">value</field>
        <field name="source_kind">manual</field>
    </record>
    <record id="ind_04_21b" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
