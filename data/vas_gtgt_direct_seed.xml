        <field name="name">Tổng doanh thu chịu thuế suất 0%</field>
        <field name="sequence">220</field>
        <field name="column_kind">value</field>
        <field name="source_kind">manual</field>
    </record>
    <record id="ind_04_22" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">22</field>
        <field name="name">DT phân phối, cung cấp hàng hóa</field>
        <field name="sequence">230</field>
        <field name="column_kind">value</field>
        <field name="source_kind">ledger_direct_revenue</field>
