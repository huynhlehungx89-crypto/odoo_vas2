    </record>
    <record id="ind_03_22" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
        <field name="code">22</field>
        <field name="name">Giá thanh toán vàng bạc đá quý bán ra</field>
        <field name="sequence">220</field>
        <field name="column_kind">value</field>
        <field name="source_kind">ledger_gold_revenue</field>
    </record>
    <record id="ind_03_23" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
