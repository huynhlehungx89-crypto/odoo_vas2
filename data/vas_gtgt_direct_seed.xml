    </record>
    <record id="ind_03_25" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
        <field name="code">25</field>
        <field name="name">Điều chỉnh giảm GTGT âm các kỳ trước</field>
        <field name="sequence">250</field>
        <field name="column_kind">value</field>
        <field name="source_kind">manual</field>
    </record>
    <record id="ind_03_26" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
        <field name="code">26</field>
        <field name="name">GTGT chịu thuế trong kỳ</field>
        <field name="sequence">260</field>
        <field name="column_kind">value</field>
        <field name="source_kind">formula</field>
        <field name="formula">[22]-[23]-[21]-[24]+[25]</field>
    </record>
    <record id="ind_03_26a" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
        <field name="code">26a</field>
        <field name="name">GTGT xuất khẩu</field>
        <field name="sequence">270</field>
        <field name="column_kind">value</field>
        <field name="source_kind">manual</field>
    </record>
    <record id="ind_03_26b" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
        <field name="code">26b</field>
        <field name="name">GTGT tiêu thụ nội địa</field>
        <field name="sequence">280</field>
        <field name="column_kind">value</field>
        <field name="source_kind">formula</field>
        <field name="formula">[26]-[26a]</field>
    </record>
    <record id="ind_03_27" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
        <field name="code">27</field>
        <field name="name">Thuế GTGT phải nộp</field>
        <field name="sequence">290</field>
        <field name="column_kind">tax</field>
        <field name="source_kind">formula</field>
        <field name="formula">[26b]*0.1;max0</field>
