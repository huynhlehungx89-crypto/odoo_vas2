    <record id="ind_04_28" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">28</field>
        <field name="name">DT hoạt động kinh doanh khác</field>
        <field name="sequence">290</field>
        <field name="column_kind">value</field>
        <field name="source_kind">ledger_direct_revenue</field>
        <field name="ledger_tag">OTHER</field>
    </record>
    <record id="ind_04_29" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">29</field>
        <field name="name">Thuế KD khác</field>
        <field name="sequence">300</field>
        <field name="column_kind">tax</field>
        <field name="source_kind">direct_industry_tax</field>
        <field name="ledger_tag">OTHER</field>
    </record>
    <record id="ind_04_30" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">30</field>
        <field name="name">Tổng DT chịu thuế theo tỷ lệ</field>
        <field name="sequence">310</field>
        <field name="column_kind">value</field>
        <field name="source_kind">formula</field>
        <field name="formula">[22]+[24]+[26]+[28]</field>
    </record>
    <record id="ind_04_31" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">31</field>
        <field name="name">Tổng thuế phải nộp theo tỷ lệ</field>
        <field name="sequence">320</field>
        <field name="column_kind">tax</field>
        <field name="source_kind">formula</field>
        <field name="formula">[23]+[25]+[27]+[29]</field>
    </record>
    <record id="ind_04_30a" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">30a</field>
        <field name="name">Tổng DT chịu thuế (gồm 0%)</field>
        <field name="sequence">330</field>
        <field name="column_kind">value</field>
        <field name="source_kind">formula</field>
        <field name="formula">[21b]+[30]</field>
    </record>
    <record id="ind_04_32" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_04_tt89"/>
        <field name="code">32</field>
        <field name="name">Tổng doanh thu</field>
        <field name="sequence">340</field>
        <field name="column_kind">value</field>
        <field name="source_kind">formula</field>
        <field name="formula">[21a]+[30a]</field>
    </record>

    <!-- Chỉ tiêu 03 -->
    <record id="ind_03_21" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
