        <field name="name">Giá thanh toán vàng bạc đá quý mua vào</field>
        <field name="sequence">230</field>
        <field name="column_kind">value</field>
        <field name="source_kind">ledger_gold_cost</field>
    </record>
    <record id="ind_03_24" model="vas.gtgt.indicator">
        <field name="form_version_id" ref="vas_gtgt_version_03_tt89"/>
