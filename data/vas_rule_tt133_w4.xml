        <field name="side">debit</field>
        <field name="account_selector">tax_output</field>
        <field name="amount_selector">tax</field>
    </record>
    <record id="vas_rule_tt133_r04_l3" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r04"/>
        <field name="sequence">30</field>
        <field name="side">credit</field>
        <field name="account_selector">partner_receivable</field>
        <field name="amount_selector">total</field>
    </record>

    <!-- W4 R08 (sửa ở TRỤC 2): chi phí mua ngoài — Nợ TK chi phí theo bảng ánh xạ
         / Nợ 1331 / Có 331. Chỉ ghi phần các DÒNG DỊCH VỤ của hóa đơn; phần dòng
         hàng tồn kho do R06 (giá) + R07 (thuế) ghi. Hết hardcode 6421. -->
    <record id="vas_rule_tt133_r08" model="vas.rule">
        <field name="code">R08</field>
        <field name="name">Chi phí mua ngoài</field>
        <field name="regime_id" ref="vas_regime_tt133"/>
        <field name="event_type">purchase_service</field>
        <field name="sequence">48</field>
        <field name="active" eval="True"/>
    </record>
    <record id="vas_rule_tt133_r08_l1" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r08"/>
        <field name="sequence">10</field>
        <field name="side">debit</field>
        <field name="account_selector">product_expense</field>
        <field name="account_id" eval="False"/>
        <field name="amount_selector">untaxed</field>
    </record>
    <record id="vas_rule_tt133_r08_l2" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r08"/>
        <field name="sequence">20</field>
        <field name="side">debit</field>
        <field name="account_selector">tax_input</field>
        <field name="amount_selector">tax</field>
    </record>
    <record id="vas_rule_tt133_r08_l3" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r08"/>
        <field name="sequence">30</field>
        <field name="side">credit</field>
        <field name="account_selector">partner_payable</field>
