<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- W4 R03: out_refund — đảo doanh thu/thuế, TK doanh thu tra theo nhóm SP -->
    <record id="vas_rule_tt133_r03" model="vas.rule">
        <field name="code">R03</field>
        <field name="name">Trả lại hàng bán (hóa đơn)</field>
        <field name="regime_id" ref="vas_regime_tt133"/>
        <field name="event_type">sale_refund</field>
        <field name="sequence">15</field>
        <field name="active" eval="True"/>
    </record>
    <record id="vas_rule_tt133_r03_l1" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r03"/>
        <field name="sequence">10</field>
        <field name="side">debit</field>
        <field name="account_selector">product_revenue</field>
        <field name="amount_selector">untaxed</field>
    </record>
    <record id="vas_rule_tt133_r03_l2" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r03"/>
        <field name="sequence">20</field>
        <field name="side">debit</field>
        <field name="account_selector">tax_output</field>
        <field name="amount_selector">tax</field>
    </record>
    <record id="vas_rule_tt133_r03_l3" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r03"/>
        <field name="sequence">30</field>
        <field name="side">credit</field>
        <field name="account_selector">partner_receivable</field>
        <field name="amount_selector">total</field>
    </record>

    <!-- W4 R03 stock: nhập lại hàng bán trả — Nợ TK tồn kho / Có TK giá vốn, theo nhóm SP -->
    <record id="vas_rule_tt133_r03s" model="vas.rule">
        <field name="code">R03s</field>
        <field name="name">Nhập kho hàng bán trả lại</field>
        <field name="regime_id" ref="vas_regime_tt133"/>
        <field name="event_type">sale_return_stock</field>
        <field name="sequence">25</field>
        <field name="active" eval="True"/>
    </record>
    <record id="vas_rule_tt133_r03s_l1" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r03s"/>
        <field name="sequence">10</field>
        <field name="side">debit</field>
        <field name="account_selector">product_inventory</field>
        <field name="amount_selector">cogs</field>
    </record>
    <record id="vas_rule_tt133_r03s_l2" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r03s"/>
        <field name="sequence">20</field>
        <field name="side">credit</field>
        <field name="account_selector">product_cogs</field>
        <field name="amount_selector">cogs</field>
    </record>

    <!-- W4 R04: credit note giảm giá (cùng cấu trúc R03; scanner gán khi không có nhập kho trả) -->
    <record id="vas_rule_tt133_r04" model="vas.rule">
        <field name="code">R04</field>
        <field name="name">Chiết khấu/giảm giá bán (phi kho)</field>
        <field name="regime_id" ref="vas_regime_tt133"/>
