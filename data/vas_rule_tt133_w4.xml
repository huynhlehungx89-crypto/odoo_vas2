    <record id="vas_rule_tt133_r04_l1" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r04"/>
        <field name="sequence">10</field>
        <field name="side">debit</field>
        <field name="account_selector">product_revenue</field>
        <field name="amount_selector">untaxed</field>
    </record>
    <record id="vas_rule_tt133_r04_l2" model="vas.rule.line">
        <field name="rule_id" ref="vas_rule_tt133_r04"/>
