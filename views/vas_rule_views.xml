<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_rule_list" model="ir.ui.view">
        <field name="name">vas.rule.list</field>
        <field name="model">vas.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="regime_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vas_rule_form" model="ir.ui.view">
        <field name="name">vas.rule.form</field>
        <field name="model">vas.rule</field>
        <field name="arch" type="xml">
            <form string="Quy tắc định khoản">
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="vd. Hóa đơn bán hàng"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="event_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="regime_id"/>
                            <field name="condition" placeholder='[("move_type","=","out_invoice")]'/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dòng quy tắc" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="side"/>
                                    <field name="account_selector"/>
                                    <field name="account_id"
                                             invisible="account_selector != 'fixed'"
                                             required="account_selector == 'fixed'"/>
                                    <field name="amount_selector"/>
                                    <field name="regime_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vas_rule" model="ir.actions.act_window">
        <field name="name">Quy tắc định khoản</field>
        <field name="res_model">vas.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vas_rule"
              name="Quy tắc định khoản"
              parent="menu_vas_config"
              action="action_vas_rule"
              sequence="60"/>
</odoo>
