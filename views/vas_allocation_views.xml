<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== HM8 — Cấu hình phân bổ ========== -->
    <record id="view_vas_allocation_config_list" model="ir.ui.view">
        <field name="name">vas.allocation.config.list</field>
        <field name="model">vas.allocation.config</field>
        <field name="arch" type="xml">
            <list string="Cấu hình phân bổ">
                <field name="cost_item_id"/>
                <field name="scope_type"/>
                <field name="scope_object_id" optional="show"/>
                <field name="criterion"/>
                <field name="sequence"/>
                <field name="date_from" widget="date"/>
                <field name="date_to" widget="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_vas_allocation_config_form" model="ir.ui.view">
        <field name="name">vas.allocation.config.form</field>
        <field name="model">vas.allocation.config</field>
        <field name="arch" type="xml">
            <form string="Cấu hình phân bổ">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cost_item_id"
                                     domain="[('is_aggregate_node','=',False),('code','!=','CPD'),('company_id','=',company_id)]"/>
                            <field name="scope_type"/>
                            <field name="scope_object_id"
                                     required="scope_type != 'company'"
                                     invisible="scope_type == 'company'"
                                     domain="[('company_id','=',company_id)]"/>
                            <field name="criterion"/>
                            <field name="sequence"/>
                            <field name="date_from" widget="date"/>
                            <field name="date_to" widget="date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook invisible="criterion not in ('manual_factor', 'named')">
                        <page string="Hệ số theo đối tượng">
                            <div class="oe_button_box">
                                <button name="action_export_factors_xlsx" type="object"
                                        string="Xuất Excel" class="btn-secondary"/>
                                <button name="action_open_factor_import" type="object"
                                        string="Nhập Excel" class="btn-secondary"/>
                            </div>
                            <field name="factor_ids">
                                <list editable="bottom">
                                    <field name="cost_object_id"
                                             domain="[('company_id','=',parent.company_id)]"/>
                                    <field name="factor"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vas_allocation_config" model="ir.actions.act_window">
        <field name="name">Cấu hình phân bổ</field>
        <field name="res_model">vas.allocation.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_vas_allocation_factor_import_form" model="ir.ui.view">
        <field name="name">vas.allocation.factor.import.wizard.form</field>
        <field name="model">vas.allocation.factor.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập hệ số">
                <group>
                    <field name="config_id" readonly="1"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Nhập"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ========== HM9 — Lượt phân bổ ========== -->
    <record id="view_vas_allocation_run_list" model="ir.ui.view">
        <field name="name">vas.allocation.run.list</field>
        <field name="model">vas.allocation.run</field>
        <field name="arch" type="xml">
            <list string="Lượt phân bổ chi phí chung">
                <field name="name"/>
                <field name="company_id"/>
                <field name="date_from" widget="date"/>
                <field name="date_to" widget="date"/>
                <field name="cost_item_id"/>
                <field name="scope_type"/>
                <field name="scope_object_id" optional="hide"/>
                <field name="round_number"/>
                <field name="money_source"/>
                <field name="state"
                         decoration-info="state == 'draft'"
                         decoration-success="state == 'confirmed'"
                         decoration-muted="state == 'cancelled'"
                         widget="badge"/>
                <field name="amount_source" optional="show"/>
                <field name="amount_unallocated" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_vas_allocation_run_form" model="ir.ui.view">
        <field name="name">vas.allocation.run.form</field>
        <field name="model">vas.allocation.run</field>
        <field name="arch" type="xml">
            <form string="Lượt phân bổ chi phí chung">
                <header>
                    <button name="action_compute" type="object" string="Tính"
                            class="btn-primary"
                            invisible="state == 'cancelled'"/>
                    <button name="action_recompute" type="object" string="Tính lại"
                            invisible="state == 'cancelled'"/>
                    <button name="action_confirm" type="object" string="Xác nhận"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object" string="Về nháp"
                            invisible="state != 'confirmed'"/>
                    <button name="action_new_version" type="object"
                            string="Tạo phiên bản mới"/>
                    <button name="action_view_previous_versions" type="object"
                            string="Xem phiên bản cũ"/>
                    <button name="action_view_receiving_periods" type="object"
                            string="Kỳ đã nhận…"/>
                    <field name="state" widget="statusbar"
                             statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="date_from" widget="date"/>
                            <field name="date_to" widget="date"/>
                            <field name="cost_item_id"
                                     domain="[('is_aggregate_node','=',False),('code','!=','CPD'),('company_id','=',company_id)]"/>
                            <field name="scope_type"/>
                            <field name="scope_object_id"
                                     required="scope_type != 'company'"
                                     invisible="scope_type == 'company'"/>
                            <field name="round_number"/>
                            <field name="money_source"/>
                            <field name="config_id" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="previous_run_id" readonly="1"/>
                            <field name="compute_ok" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Ba trạng thái tiền">
                            <field name="amount_source"
                                     class="text-primary"/>
                            <field name="amount_unallocated"
                                     class="text-danger"
                                     string="① Chưa phân bổ được"/>
                            <field name="amount_pending_period"
                                     class="text-warning"
                                     string="② Đã xác định, chưa kỳ nhận"/>
                            <field name="amount_received"
                                     class="text-success"
                                     string="③ Đã được kỳ nhận"/>
                            <field name="amount_allocated" string="Tổng đã xác định"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not unallocated_reason">
                        <field name="unallocated_reason" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Phần theo đối tượng">
                            <field name="result_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="cost_object_id"/>
                                    <field name="criterion_value"/>
                                    <field name="ratio" string="Tỷ lệ (chưa làm tròn)"/>
                                    <field name="ratio_display" string="Tỷ lệ %"/>
                                    <field name="amount" sum="Tổng"/>
                                    <field name="amount_received" sum="Đã nhận"/>
                                    <field name="receiving_period_ids" widget="many2many_tags"
                                             optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Truy vết nguồn">
                            <field name="trace_ids">
                                <list>
                                    <field name="cost_object_id"/>
                                    <field name="source_move_line_id"/>
                                    <field name="source_result_id" optional="hide"/>
                                    <field name="amount" sum="Tổng đóng góp"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vas_allocation_run" model="ir.actions.act_window">
        <field name="name">Lượt phân bổ chi phí chung</field>
        <field name="res_model">vas.allocation.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vas_allocation_config"
              name="Cấu hình phân bổ"
              parent="menu_vas_costing_root"
              action="action_vas_allocation_config"
              sequence="40"/>
    <!-- Lượt phân bổ: chuyển sang lưu đồ Nghiệp vụ › Sản xuất & Giá thành -->
</odoo>
