<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_b03_wizard_form" model="ir.ui.view">
        <field name="name">vas.b03.wizard.form</field>
        <field name="model">vas.b03.wizard</field>
        <field name="arch" type="xml">
            <form string="Lập Báo cáo LCTT (B03)">
                <group>
                    <field name="company_id"/>
                    <field name="regime_id"/>
                    <field name="period_from_id"
                              domain="[('fiscalyear_id.company_id', '=', company_id)]"/>
                    <field name="period_to_id"
                              domain="[('fiscalyear_id.company_id', '=', company_id)]"/>
                    <field name="hide_reversed"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Lập báo cáo"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vas_b03_generate" model="ir.actions.act_window">
        <field name="name">Lập B03</field>
        <field name="res_model">vas.b03.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_vas_b03_snapshots" model="ir.actions.act_window">
        <field name="name">Bản B03 đã lập</field>
        <field name="res_model">vas.report.snapshot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('form_code', '=', 'B03-DNN')]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_vas_b03_client" model="ir.actions.client">
        <field name="name">Báo cáo lưu chuyển tiền tệ</field>
        <field name="tag">vas_report_client</field>
        <field name="path">vas-b03</field>
        <field name="context">{
            'report_model': 'vas.b03.wizard',
            'report_title': 'Báo cáo lưu chuyển tiền tệ',
        }</field>
    </record>

    <menuitem id="menu_vas_b03"
              name="Báo cáo LCTT (B03)"
              parent="menu_vas_books"
              action="action_vas_b03_client"
              sequence="50"/>

    <menuitem id="menu_vas_b03_generate"
              name="Lập B03 mới"
              parent="menu_vas_books"
              action="action_vas_b03_generate"
              sequence="51"/>

    <menuitem id="menu_vas_b03_snapshots"
              name="Bản B03 đã lập"
              parent="menu_vas_books"
              action="action_vas_b03_snapshots"
              sequence="52"/>
</odoo>
