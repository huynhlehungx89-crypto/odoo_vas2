<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_closing_entry_list" model="ir.ui.view">
        <field name="name">vas.closing.entry.list</field>
        <field name="model">vas.closing.entry</field>
        <field name="arch" type="xml">
            <list string="Kết chuyển" default_order="date_to desc, id desc"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'posted'">
                <field name="accounting_date" string="Ngày hạch toán"/>
                <field name="document_date" string="Ngày chứng từ"/>
                <field name="name" string="Số chứng từ"/>
                <field name="note" string="Diễn giải"/>
                <field name="date_to" string="Đến ngày" optional="show"/>
                <field name="state" string="Trạng thái" widget="badge"
                         decoration-info="state == 'draft'"
                         decoration-warning="state == 'ready'"
                         decoration-success="state == 'posted'"
                         decoration-danger="state == 'cancelled'"/>
                <field name="amount_total" string="Tổng tiền" sum="Tổng"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="is_year_end" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vas_closing_entry_form" model="ir.ui.view">
        <field name="name">vas.closing.entry.form</field>
        <field name="model">vas.closing.entry</field>
        <field name="arch" type="xml">
            <form string="Phiếu kết chuyển">
                <header>
                    <button name="action_post" string="Ghi sổ" type="object"
                            invisible="state not in ('draft', 'ready')"
                            class="btn-primary"/>
                    <button name="action_set_draft" string="Hủy (về nháp)" type="object"
                            invisible="state not in ('ready',)"/>
                    <button name="action_reverse_entry" string="Đảo" type="object"
                            invisible="state != 'posted'"
                            confirm="Đảo toàn bộ chứng từ trong lô kết chuyển và hủy phiếu?"/>
                    <field name="state" widget="statusbar"
                            statusbar_visible="draft,ready,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_fetch_data"
                                icon="fa-refresh"
                                invisible="state not in ('draft', 'ready')">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Lấy dữ liệu</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Số chứng từ"/>
                        <h1><field name="name" readonly="1" placeholder="/"/></h1>
                    </div>
                    <field name="warning_html" nolabel="1" invisible="not warning_html"/>
                    <group>
                        <group>
                            <label for="date_to" string="Kết chuyển đến ngày"/>
                            <div class="o_row">
                                <field name="date_to" nolabel="1"
                                         readonly="state in ('posted', 'cancelled')"/>
                                <button name="action_fetch_data" string="Lấy dữ liệu"
                                        type="object" class="btn-primary"
                                        invisible="state not in ('draft', 'ready')"/>
                            </div>
                            <field name="note" string="Diễn giải"
                                     readonly="state in ('posted', 'cancelled')"
                                     placeholder="Diễn giải phiếu kết chuyển"/>
                            <field name="accounting_date"
                                     readonly="state in ('posted', 'cancelled')"/>
                            <field name="document_date"
                                     readonly="state in ('posted', 'cancelled')"/>
                            <field name="date_from" readonly="state in ('posted', 'cancelled')"/>
                            <field name="is_year_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                     readonly="state in ('posted', 'cancelled')"/>
                            <field name="regime_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="move_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Nhóm chạy">
                        <group>
                            <field name="run_kqkd" readonly="state in ('posted', 'cancelled')"/>
                            <field name="run_year_start" readonly="state in ('posted', 'cancelled')"/>
                            <field name="run_vat" readonly="state in ('posted', 'cancelled')"/>
                            <field name="run_fx" readonly="state in ('posted', 'cancelled')"/>
                            <field name="run_prepaid" readonly="state in ('posted', 'cancelled')"/>
                            <field name="run_manual" readonly="state in ('posted', 'cancelled')"/>
                            <field name="run_cit" readonly="state in ('posted', 'cancelled')"/>
                        </group>
                        <group string="Thuế thu nhập doanh nghiệp" invisible="not run_cit">
                            <field name="cit_amount"
                                     readonly="state in ('posted', 'cancelled')"/>
                            <field name="cit_nature"
                                     readonly="state in ('posted', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dòng kết chuyển" name="lines">
                            <field name="line_ids" readonly="state in ('posted', 'cancelled')">
                                <list editable="bottom"
                                      decoration-warning="needs_amount"
                                      decoration-muted="excluded">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Diễn giải"/>
                                    <field name="account_debit_id" string="TK Nợ"/>
                                    <field name="account_credit_id" string="TK Có"/>
                                    <field name="amount" string="Số tiền" sum="Tổng tiền"/>
                                    <field name="needs_amount" column_invisible="1"/>
                                    <field name="is_manual" string="Nhập tay" optional="show"/>
                                    <field name="is_inherited" optional="hide"/>
                                    <field name="template_code" optional="hide"/>
                                    <field name="balance_hint" optional="hide"/>
                                    <field name="rule_id" optional="hide"/>
                                    <field name="layer" optional="hide"/>
                                    <field name="excluded" string="Bỏ" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chứng từ đã sinh" name="moves"
                              invisible="not move_ids">
                            <field name="move_ids" readonly="1">
                                <list create="0" delete="0" edit="0"
                                      decoration-muted="state == 'reversed'">
                                    <field name="name" string="Số chứng từ"/>
                                    <field name="date"/>
                                    <field name="move_kind"/>
                                    <field name="ref" string="Diễn giải"/>
                                    <field name="state"/>
                                    <field name="is_reversal" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vas_closing_entry_search" model="ir.ui.view">
        <field name="name">vas.closing.entry.search</field>
        <field name="model">vas.closing.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="note"/>
                <field name="date_to"/>
                <filter name="filter_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_ready" string="Đã lấy dữ liệu" domain="[('state', '=', 'ready')]"/>
                <filter name="filter_posted" string="Đã ghi sổ" domain="[('state', '=', 'posted')]"/>
            </search>
        </field>
    </record>

    <record id="action_vas_closing_entry" model="ir.actions.act_window">
        <field name="name">Kết chuyển</field>
        <field name="res_model">vas.closing.entry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phiếu kết chuyển cuối kỳ.
            </p>
            <p>Chọn «Kết chuyển đến ngày» → Lấy dữ liệu → duyệt dòng → Ghi sổ.</p>
        </field>
    </record>

    <!-- Folder «Cuối kỳ» bỏ: Kết chuyển chuyển sang Nghiệp vụ (bước 2 Tổng hợp). -->
    <menuitem id="menu_vas_closing_entry"
              name="Kết chuyển"
              parent="menu_vas_ops"
              action="action_vas_closing_entry"
              sequence="20"/>
</odoo>
