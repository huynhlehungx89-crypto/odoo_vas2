<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vas_debt_offset_tree" model="ir.ui.view">
        <field name="name">vas.debt.offset.list</field>
        <field name="model">vas.debt.offset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="amount_receivable"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_vas_debt_offset_form" model="ir.ui.view">
        <field name="name">vas.debt.offset.form</field>
        <field name="model">vas.debt.offset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" string="Ghi sổ" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reverse" string="Đảo" type="object"
                            invisible="state != 'posted'"/>
                    <button name="action_cancel" string="Hủy" type="object"
                            invisible="state != 'posted'"
                            confirm="Hủy phiếu và đảo bút toán VAS?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="ref" readonly="state != 'draft'"/>
                            <field name="vas_cash_flow_activity"/>
                        </group>
                        <group>
                            <field name="regime_id" readonly="state != 'draft'"/>
                            <field name="period_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="amount_receivable"/>
                            <field name="amount_payable"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="side"/>
                            <field name="move_line_id"/>
                            <field name="amount_residual"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vas_debt_offset" model="ir.actions.act_window">
        <field name="name">Bù trừ công nợ</field>
        <field name="res_model">vas.debt.offset</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_vas_debt_offset"
              name="Bù trừ công nợ"
              parent="menu_vas_ops"
              action="action_vas_debt_offset"
              sequence="30"/>
</odoo>
