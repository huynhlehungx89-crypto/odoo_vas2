<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Treo 113 ===== -->
    <record id="view_vas_payment_pending113_list" model="ir.ui.view">
        <field name="name">vas.payment.pending113.list</field>
        <field name="model">vas.payment.pending113</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_stale"
                  decoration-muted="state in ('matched', 'cancelled')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="invoice_id" optional="show"/>
                <field name="reference_code"/>
                <field name="amount" sum="Tổng"/>
                <field name="state"/>
                <field name="is_stale" optional="hide"/>
                <field name="match_method" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_vas_payment_pending113_form" model="ir.ui.view">
        <field name="name">vas.payment.pending113.form</field>
        <field name="model">vas.payment.pending113</field>
        <field name="arch" type="xml">
            <form string="Thu tiền đang chuyển (113)">
                <header>
                    <button name="action_post_pending" type="object"
                            string="Ghi tạm Nợ 113 / Có 131"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_settle_manual" type="object"
                            string="Xác nhận tay (Nợ 112 / Có 113)"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,matched"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="invoice_id" readonly="state != 'draft'"/>
                            <field name="reference_code" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pending_move_id" readonly="1"/>
                            <field name="settle_move_id" readonly="1"/>
                            <field name="native_payment_id" readonly="1"/>
                            <field name="match_method" readonly="1"/>
                            <field name="matched_line_id" readonly="1"/>
                            <field name="is_stale" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                     readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="state == 'matched'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vas_payment_pending113_search" model="ir.ui.view">
        <field name="name">vas.payment.pending113.search</field>
        <field name="model">vas.payment.pending113</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference_code"/>
                <field name="partner_id"/>
                <filter string="Treo 113" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Treo quá hạn" name="stale" domain="[('is_stale', '=', True)]"/>
                <filter string="Đã đối soát" name="matched" domain="[('state', '=', 'matched')]"/>
            </search>
        </field>
    </record>

    <record id="action_vas_payment_pending113" model="ir.actions.act_window">
        <field name="name">Thu đang chuyển (113)</field>
        <field name="res_model">vas.payment.pending113</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ghi nhận thu khi khách đã CK nhưng ngân hàng chưa xác nhận trên sao kê.
            </p>
            <p>Nợ 113 / Có 131 — R17 (thu đã về NH) không đổi.</p>
        </field>
    </record>

    <!-- ===== Import sao kê ===== -->
    <record id="view_vas_bank_statement_import_list" model="ir.ui.view">
        <field name="name">vas.bank.statement.import.list</field>
        <field name="model">vas.bank.statement.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bank_label"/>
                <field name="import_date"/>
                <field name="line_count"/>
                <field name="matched_count"/>
                <field name="unmatched_count"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_vas_bank_statement_import_form" model="ir.ui.view">
        <field name="name">vas.bank.statement.import.form</field>
        <field name="model">vas.bank.statement.import</field>
        <field name="arch" type="xml">
            <form string="Import sao kê ngân hàng">
                <header>
                    <button name="action_parse_file" type="object"
                            string="Nhập file"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_run_matching" type="object"
                            string="Chạy đối soát"
                            class="btn-primary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,imported,matched"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bank_label"/>
                            <field name="settle_account_code"/>
                            <field name="data_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="import_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="line_count"/>
                            <field name="matched_count"/>
                            <field name="unmatched_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dòng sao kê">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'matched'"
                                      decoration-warning="state == 'ambiguous'"
                                      decoration-muted="state == 'ignored'">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="narration"/>
                                    <field name="state"/>
                                    <field name="pending_id"/>
                                    <field name="match_method"/>
                                    <field name="manual_pending_id"/>
                                    <field name="match_note"/>
                                    <button name="action_confirm_manual" type="object"
                                            string="Khớp tay"
                                            invisible="state == 'matched'"/>
                                    <button name="action_ignore" type="object"
                                            string="Bỏ qua"
                                            invisible="state in ('matched', 'ignored')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vas_bank_statement_import" model="ir.actions.act_window">
        <field name="name">Import sao kê NH</field>
        <field name="res_model">vas.bank.statement.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import CSV sao kê để đối soát các bút toán treo 113.</p>
            <p>CSV tối thiểu: cột ngày, số tiền (Có), nội dung. Parser riêng từng NH sẽ bổ sung sau.</p>
        </field>
    </record>
</odoo>
