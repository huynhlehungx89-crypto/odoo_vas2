<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: nhóm gắn privilege, không còn category_id trên res.groups -->
    <record model="res.groups.privilege" id="res_groups_privilege_vas_costing">
        <field name="name">Giá thành VAS</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_vas_costing_approver" model="res.groups">
        <field name="name">Duyệt giá thành</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_vas_costing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
